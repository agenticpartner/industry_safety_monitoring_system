# Deployment settings for docker/compose.yml. Copy to docker/.env and edit; it is gitignored.
#
#     cp docker/.env.example docker/.env
#
# TWO env files, with different jobs, because Compose treats them differently:
#
#   docker/.env    THIS file. Compose reads it to substitute ${...} in compose.yml, so it sets
#                  what the deployment IS — source mode, stream count, camera addresses.
#                  Compose looks for it next to the compose file, which is why it lives here.
#
#   <repo>/.env    Credentials, from .env.example at the repo root. Injected INTO the containers
#                  by `env_file`, and the same file scripts/env.sh sources on the Jetson.
#
# Putting an ISMS_* value in the repo-root .env does not work: compose interpolates from this
# directory, and the `environment:` block then overrides whatever env_file supplied. It fails
# silently — the deployment simply runs with the default.
#
# Anything set here can be overridden per-command:
#     ISMS_SOURCE=rtsp docker compose -f docker/compose.yml up -d app

# --- what to run --------------------------------------------------------------------------------
# ISMS_STREAMS=20
# ISMS_SOURCE=file             # file | rtsp
# ISMS_WIPE=1                  # wipe previous incidents on start
# ISMS_AUTOSTART=1             # start the pipeline on boot, not just the API

# --- cameras (rtsp mode) ------------------------------------------------------------------------
# One URL per camera; position in the list IS the camera id. Credentials in these URLs are the
# reason they belong in a gitignored file rather than in configs/demo.yml.
# ISMS_RTSP_URLS=rtsp://user:pw@10.0.0.11/Streaming/Channels/101,rtsp://user:pw@10.0.0.12/axis-media/media.amp
#
# Or a single server with numbered mounts:
# ISMS_RTSP_BASE=rtsp://10.0.0.5:8554

# --- optional -----------------------------------------------------------------------------------
# ISMS_RGB_CAPTURE=            # subject crops; unset follows the source mode
# ISMS_WAIT_VLM_S=2400         # how long to watch for the VLM before running vision-only
# CUDA_ARCHS=80;86;89;90       # compute capabilities llama.cpp is built for
