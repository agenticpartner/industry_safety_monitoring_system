# Copy to `.env` and fill in your own values:
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored and must stay that way. Nothing in this repository ships with credentials,
# and none of these values have defaults — a missing token disables the feature that needs it
# rather than falling back to somebody else's account.
#
# Read from a file rather than your shell profile on purpose: Ubuntu's default .bashrc returns
# early for non-interactive shells, so an `export` there is invisible to exactly the systemd,
# nohup and `ssh host 'cmd'` invocations that need it. scripts/env.sh sources this explicitly.


# --- Hugging Face -----------------------------------------------------------------------------
# Needed only for the optional reasoning layer (scripts/setup_reasoning.sh), which pulls the
# vision and language model weights. A free read-scope token is enough:
#     https://huggingface.co/settings/tokens
# The detector models in scripts/export_models.py are public and need no token.
HF_TOKEN=

# --- Telegram ---------------------------------------------------------------------------------
# Needed only if you turn on notify.telegram.enabled in configs/services.yml (off by default —
# an alert pushed to someone's phone cannot be unsent).
#
#   1. Message @BotFather in Telegram, send /newbot, copy the token it gives you
#   2. Add the bot to a group, or just send it a direct message
#   3. Get the chat id — either run ./scripts/telegram_setup.sh, or:
#        curl "https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates"
#      and read `.result[].message.chat.id` out of the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ------------------------------------------------------------------------
# Pin the X display for the local nv3dsink output. Leave unset to auto-detect: scripts/env.sh
# probes /tmp/.X11-unix for a live socket. Set this only when detection picks the wrong server —
# a Jetson running a desktop session commonly has X on :1, not :0.
# DISPLAY_NUM=:1

# Where DeepStream is installed, if not the default.
# DS_ROOT=/opt/nvidia/deepstream/deepstream

# Cap the stream count for smaller boards. 20 is 91% of the measured AGX Orin 64GB NVDEC ceiling
# for 1080p30 H.265; an Orin NX or Nano wants a lower number.
# MAX_STREAMS=20
